# ============================================================================
# FINGER CHESS — Backend Environment Configuration
# ============================================================================
# Naming convention: every Finger Chess-specific variable is prefixed
# FINGER_CHESS_. Three variables are deliberately left unprefixed because
# they follow universal Node.js/hosting-platform conventions — see the
# comment in src/config/configuration.ts for the full reasoning.

# --- Universal platform conventions (NOT prefixed) ---
NODE_ENV=development
PORT=3000

# Database
# Prisma reads connection pool sizing directly from these query params —
# there's no separate config file for it. Left unset, Prisma defaults to
# (num_cpus * 2 + 1) connections PER INSTANCE, which is fine for one
# process and dangerously wrong once you're running N replicas behind a
# load balancer. Size `connection_limit` for one instance assuming several
# will run concurrently.
DATABASE_URL=postgresql://finger_chess_user:finger_chess_pass@localhost:5432/finger_chess?schema=public&connection_limit=10&pool_timeout=10

# --- Finger Chess application configuration (FINGER_CHESS_ prefixed) ---

# Redis
FINGER_CHESS_REDIS_HOST=localhost
FINGER_CHESS_REDIS_PORT=6379
FINGER_CHESS_REDIS_PASSWORD=

# JWT
FINGER_CHESS_JWT_ACCESS_SECRET=change_me_access_secret
FINGER_CHESS_JWT_ACCESS_EXPIRES_IN=15m
FINGER_CHESS_JWT_REFRESH_SECRET=change_me_refresh_secret
FINGER_CHESS_JWT_REFRESH_EXPIRES_IN=7d

# Payments
FINGER_CHESS_STRIPE_SECRET_KEY=sk_test_xxx
FINGER_CHESS_STRIPE_WEBHOOK_SECRET=whsec_xxx

# File Upload (S3-compatible) — KYC document storage
FINGER_CHESS_AWS_REGION=ap-south-1
FINGER_CHESS_AWS_S3_BUCKET=finger-chess-uploads
FINGER_CHESS_AWS_ACCESS_KEY_ID=
FINGER_CHESS_AWS_SECRET_ACCESS_KEY=

# Rate Limiting
FINGER_CHESS_THROTTLE_TTL=60
FINGER_CHESS_THROTTLE_LIMIT=100

# Frontend (for email links and OAuth redirects)
FINGER_CHESS_FRONTEND_URL=https://app.fingerchess.com
FINGER_CHESS_API_BASE_URL=https://api.fingerchess.com

# Google OAuth
FINGER_CHESS_GOOGLE_CLIENT_ID=
FINGER_CHESS_GOOGLE_CLIENT_SECRET=
FINGER_CHESS_GOOGLE_CALLBACK_URL=https://api.fingerchess.com/api/v1/auth/google/callback

# Discord OAuth
FINGER_CHESS_DISCORD_CLIENT_ID=
FINGER_CHESS_DISCORD_CLIENT_SECRET=
FINGER_CHESS_DISCORD_CALLBACK_URL=https://api.fingerchess.com/api/v1/auth/discord/callback

# 2FA
FINGER_CHESS_TWO_FACTOR_APP_NAME=Finger Chess

# Social system — message-at-rest encryption key (see
# social/messaging/util/message-encryption.service.ts). Generate with:
#   openssl rand -base64 32
# Rotating this key makes every previously-encrypted message undecryptable
# — treat it with the same care as the JWT secrets.
FINGER_CHESS_MESSAGE_ENCRYPTION_KEY=change_me_generate_with_openssl_rand

# Compliance — age gating, platform rules, and penalty durations
# Minimum age (in years) required to join any REAL-MONEY match. Free/practice
# matches remain available below this age; only paid matchmaking and every
# money feature (deposit, withdraw, KYC submission) are gated on it.
FINGER_CHESS_MINIMUM_AGE=18
# Bump this string whenever the platform rules text changes — every user
# must re-accept the new version before continuing, and their prior
# acceptance of the old version is preserved (rule_acceptances is a history,
# not a single overwritten flag).
FINGER_CHESS_PLATFORM_RULES_VERSION=1.0
# Default penalty durations — captured onto each PenaltyRecord at the moment
# it's issued, so changing these later never rewrites the duration of a
# penalty that already happened.
FINGER_CHESS_PENALTY_CHEATING_SUSPENSION_HOURS=168
FINGER_CHESS_PENALTY_CHAT_ABUSE_MUTE_HOURS=72

# Account Lockout
FINGER_CHESS_MAX_FAILED_LOGIN_ATTEMPTS=5
FINGER_CHESS_ACCOUNT_LOCK_MINUTES=15

# Mail (SMTP or provider-compatible)
FINGER_CHESS_MAIL_HOST=smtp.sendgrid.net
FINGER_CHESS_MAIL_PORT=587
FINGER_CHESS_MAIL_USER=apikey
FINGER_CHESS_MAIL_PASSWORD=
FINGER_CHESS_MAIL_FROM="Finger Chess" <no-reply@fingerchess.com>

# Security — see SECURITY_AUDIT.md sections 4.2 and 9.1
# Comma-separated list of allowed frontend origins. REQUIRED in production —
# the app refuses to start without it rather than silently falling back to
# a wildcard. Used for both HTTP CORS (main.ts) and WebSocket CORS
# (config/ws-cors.ts).
FINGER_CHESS_CORS_ORIGINS=http://localhost:3001,http://localhost:5174
# Number of trusted reverse-proxy hops in front of this service (nginx/ALB/
# CDN). Must match real infrastructure — every rate limiter and fraud/IP
# check depends on req.ip resolving correctly. 1 for a single reverse proxy.
FINGER_CHESS_TRUST_PROXY_HOPS=1
