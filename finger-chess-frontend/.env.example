# ============================================================================
# FINGER CHESS — Player Frontend Environment Configuration
# ============================================================================
# Naming: NEXT_PUBLIC_ is Next.js's own required prefix (anything without it
# is invisible to browser code, by Next's design) — FINGER_CHESS_ is nested
# inside it so every app-specific variable still carries the project's
# environment prefix, without breaking Next's own convention.

# Used by next.config.js's server-side rewrite so /api/* resolves to the
# backend without CORS. Read at BUILD time (inlined by the Dockerfile build
# args) — set it per environment in CI, and point it at the backend's
# in-network address in docker-compose (http://backend:3000). In Kubernetes
# the ingress routes /api directly to the backend instead.
NEXT_PUBLIC_FINGER_CHESS_API_PROXY_TARGET=http://localhost:3000

# WebSocket base URL for the /game and /matchmaking Socket.IO namespaces.
NEXT_PUBLIC_FINGER_CHESS_WS_URL=http://localhost:3000

# Stripe publishable key (safe for client-side use) — REQUIRED. Must be set to
# a real key matching the backend's Stripe account; the app throws a clear
# error at runtime when it's missing or still a placeholder (see lib/stripe.ts).
NEXT_PUBLIC_FINGER_CHESS_STRIPE_PUBLISHABLE_KEY=
